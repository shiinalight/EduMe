# Copy this file to .env. Keep your real API key on the server, never in public/.
GEMINI_API_KEY=
# Choose a vision + structured-output model available to your API key.
GEMINI_MODEL=gemini-3.6-flash
PORT=3000
# Local-only by default. For a trusted LAN test, set HOST=0.0.0.0 deliberately.
HOST=127.0.0.1
# If testing on a trusted LAN, list your computer's LAN IP here (no port).
ALLOWED_HOSTS=

# For Import from link. Use an API key from Firecrawl, not your event coupon.
FIRECRAWL_API_KEY=

# For voice-to-text using ElevenLabs Scribe. Math conversion uses GEMINI_API_KEY.
ELEVENLABS_API_KEY=
