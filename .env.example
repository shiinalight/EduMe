# Optional: point the Team OCR toggle at your teammate's server-side OCR endpoint.
# It must follow the JSON request/response contract described in the README.
TEAM_OCR_URL=
TEAM_OCR_NAME=Team OCR

# InkMath runs directly in this FastAPI process using GEMINI_API_KEY.
# Read handwriting transcribes; checking/saving requires separate review.
DEFAULT_OCR_PROVIDER=inkmath
# Leave empty for the unified Python provider. Only set for a legacy external service.
INKMATH_OCR_URL=

# Optional: override the local Pix2Tex address.
# PIX2TEX_URL=http://127.0.0.1:8502/predict/

# Optional voice formula transcription. Audio is sent to ElevenLabs only after
# the learner chooses to transcribe it; never put this key in the browser.
ELEVENLABS_API_KEY=

# Used to format a reviewed spoken transcript into LaTex and JSON. This app
# preserves mistakes and ambiguities for learner review; it never solves it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional public problem-link import. Firecrawl receives only the requested
# public lesson URL; local, private, and login URLs are rejected.
FIRECRAWL_API_KEY=

# Optional: HeyGen avatar videos. Keep this server-side; save and restart after editing.
HEYGEN_API_KEY=
# Optional defaults. Otherwise choose a public avatar in the app and use its default voice.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Required: PostgreSQL connection string. For Supabase, use the transaction-pooler URI
# (Project Settings > Database > Connection string > Transaction pooler, port 6543).
# Replace the placeholders; do NOT keep the [square brackets] from the dashboard template,
# and percent-encode special characters in the password (# -> %23, $ -> %24, @ -> %40,
# / -> %2F, ? -> %3F, % -> %25, [ -> %5B, ] -> %5D).
# Tables live in the private "edume_private" schema, created by `python init_db.py`.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional: defaults to "require". Use verify-full with the Supabase CA certificate for
# stricter checking. Only lower this for a local test database.
# DATABASE_SSLMODE=require
