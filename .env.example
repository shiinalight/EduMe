# Optional: point the Team OCR toggle at your teammate's server-side OCR endpoint.
# It must follow the JSON request/response contract described in the README.
TEAM_OCR_URL=https://ocr.your-team.example/recognize
TEAM_OCR_NAME=Team OCR

# The provider used silently by the Review full solution button.
# InkMath is the default and expects the teammate project at port 3000.
DEFAULT_OCR_PROVIDER=inkmath
INKMATH_OCR_URL=http://127.0.0.1:3000/api/recognize

# Optional: override the local Pix2Tex address.
# PIX2TEX_URL=http://127.0.0.1:8502/predict/

# Optional voice formula transcription. Audio is sent to ElevenLabs only after
# the learner chooses to transcribe it; never put this key in the browser.
ELEVENLABS_API_KEY=

# Used to format a reviewed spoken transcript into LaTex and JSON. This app
# preserves mistakes and ambiguities for learner review; it never solves it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional public problem-link import. Firecrawl receives only the requested
# public lesson URL; local, private, and login URLs are rejected.
FIRECRAWL_API_KEY=

# Optional: HeyGen avatar videos. Keep this server-side; save and restart after editing.
HEYGEN_API_KEY=
# Optional defaults. Otherwise choose a public avatar in the app and use its default voice.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
